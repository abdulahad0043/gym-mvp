<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>GymOS — Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet"/>
  <style>
    body { font-family: 'DM Sans', sans-serif; background: #0a0a0a; color: #e4e4e7; }
    .brand { font-family: 'Bebas Neue', sans-serif; letter-spacing: 0.05em; }
    .tab-btn.active { border-color: #f97316; color: #f97316; }
    .tab-panel { display: none; }
    .tab-panel.active { display: block; }
    .badge-active   { background:#16a34a22; color:#4ade80; border:1px solid #16a34a55; }
    .badge-overdue  { background:#dc262622; color:#f87171; border:1px solid #dc262655; }
    .badge-suspended{ background:#71717a22; color:#a1a1aa; border:1px solid #71717a55; }
  </style>
</head>
<body class="min-h-screen">

  <!-- Top Nav -->
  <nav class="border-b border-zinc-800 px-6 py-4 flex items-center justify-between">
    <span class="brand text-3xl text-orange-500">GYMOS</span>
    <button onclick="logout()" class="text-zinc-400 hover:text-white text-sm transition">Sign Out</button>
  </nav>

  <!-- Stats Bar -->
  <div id="stats" class="grid grid-cols-2 md:grid-cols-4 gap-4 px-6 py-6"></div>

  <!-- Tabs -->
  <div class="px-6">
    <div class="flex gap-4 border-b border-zinc-800 mb-6">
      <button class="tab-btn active border-b-2 pb-2 text-sm font-medium transition" data-tab="members" onclick="switchTab('members')">Members</button>
      <button class="tab-btn border-b-2 border-transparent pb-2 text-sm text-zinc-500 font-medium transition" data-tab="register" onclick="switchTab('register')">+ Register</button>
      <button class="tab-btn border-b-2 border-transparent pb-2 text-sm text-zinc-500 font-medium transition" data-tab="checkins" onclick="switchTab('checkins')">Today's Check-ins</button>
    </div>

    <!-- Members Tab -->
    <div id="tab-members" class="tab-panel active">
      <div class="flex gap-3 mb-4">
        <input id="search" oninput="filterMembers()" placeholder="Search name or phone…"
          class="flex-1 bg-zinc-900 border border-zinc-700 rounded-lg px-4 py-2 text-sm focus:outline-none focus:border-orange-500"/>
        <select id="filterStatus" onchange="filterMembers()"
          class="bg-zinc-900 border border-zinc-700 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-orange-500">
          <option value="">All</option>
          <option value="active">Active</option>
          <option value="overdue">Overdue</option>
          <option value="suspended">Suspended</option>
        </select>
      </div>
      <div id="member-list" class="space-y-3"></div>
    </div>

    <!-- Register Tab -->
    <div id="tab-register" class="tab-panel max-w-lg">
      <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 space-y-4">
        <h2 class="brand text-2xl text-orange-500">Register New Member</h2>
        <div id="reg-msg" class="hidden text-sm px-4 py-2 rounded-lg"></div>
        <div>
          <label class="text-xs text-zinc-400 uppercase tracking-widest mb-1 block">Full Name</label>
          <input id="reg-name" class="input w-full bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-2 focus:outline-none focus:border-orange-500"/>
        </div>
        <div>
          <label class="text-xs text-zinc-400 uppercase tracking-widest mb-1 block">Phone</label>
          <input id="reg-phone" type="tel" class="input w-full bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-2 focus:outline-none focus:border-orange-500"/>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="text-xs text-zinc-400 uppercase tracking-widest mb-1 block">Start Date</label>
            <input id="reg-start" type="date" class="input w-full bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-2 focus:outline-none focus:border-orange-500"/>
          </div>
          <div>
            <label class="text-xs text-zinc-400 uppercase tracking-widest mb-1 block">Expiry Date</label>
            <input id="reg-expiry" type="date" class="input w-full bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-2 focus:outline-none focus:border-orange-500"/>
          </div>
        </div>
        <button onclick="registerMember()"
          class="w-full bg-orange-500 hover:bg-orange-400 text-black font-semibold py-2.5 rounded-lg transition active:scale-95">
          Register Member
        </button>
      </div>
    </div>

    <!-- Check-ins Tab -->
    <div id="tab-checkins" class="tab-panel">
      <div id="checkin-list" class="space-y-2"></div>
    </div>
  </div>

  <!-- Plan Modal -->
  <div id="plan-modal" class="hidden fixed inset-0 bg-black/70 flex items-center justify-center z-50 px-4">
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 w-full max-w-lg space-y-4">
      <h3 class="brand text-2xl text-orange-500">Assign Plan</h3>
      <p id="plan-member-name" class="text-zinc-400 text-sm"></p>
      <div>
        <label class="text-xs text-zinc-400 uppercase tracking-widest mb-1 block">Diet Plan</label>
        <textarea id="plan-diet" rows="3" class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-2 text-sm focus:outline-none focus:border-orange-500"></textarea>
      </div>
      <div>
        <label class="text-xs text-zinc-400 uppercase tracking-widest mb-1 block">Workout Plan</label>
        <textarea id="plan-workout" rows="3" class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-2 text-sm focus:outline-none focus:border-orange-500"></textarea>
      </div>
      <div>
        <label class="text-xs text-zinc-400 uppercase tracking-widest mb-1 block">Note (optional)</label>
        <input id="plan-note" class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-2 text-sm focus:outline-none focus:border-orange-500"/>
      </div>
      <div class="flex gap-3">
        <button onclick="savePlan()" class="flex-1 bg-orange-500 hover:bg-orange-400 text-black font-semibold py-2.5 rounded-lg transition">Save Plan</button>
        <button onclick="closeModal()" class="flex-1 bg-zinc-800 hover:bg-zinc-700 text-white py-2.5 rounded-lg transition">Cancel</button>
      </div>
    </div>
  </div>

  <script>
    const token = () => localStorage.getItem('gym_token');
    const headers = () => ({ 'Content-Type': 'application/json', Authorization: `Bearer ${token()}` });

    let allMembers = [];
    let currentMemberId = null;

    // ── Auth guard ──────────────────────────────────────────
    if (!token()) window.location.href = '/';

    function logout() {
      localStorage.removeItem('gym_token');
      window.location.href = '/';
    }

    // ── Tab switching ───────────────────────────────────────
    function switchTab(name) {
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      document.querySelectorAll('.tab-btn').forEach(b => {
        b.classList.remove('active');
        b.classList.add('text-zinc-500');
        b.classList.remove('text-orange-500');
      });
      document.getElementById(`tab-${name}`).classList.add('active');
      const btn = document.querySelector(`[data-tab="${name}"]`);
      btn.classList.add('active');
      btn.classList.remove('text-zinc-500');
      if (name === 'checkins') loadCheckins();
    }

    // ── Stats ───────────────────────────────────────────────
    function renderStats(members) {
      const total   = members.length;
      const active  = members.filter(m => m.status === 'active').length;
      const overdue = members.filter(m => m.status === 'overdue').length;
      const expiring = members.filter(m => m.daysRemaining >= 0 && m.daysRemaining <= 7).length;

      const cards = [
        { label: 'Total Members', value: total, color: 'text-white' },
        { label: 'Active',        value: active,  color: 'text-green-400' },
        { label: 'Overdue',       value: overdue, color: 'text-red-400' },
        { label: 'Expiring ≤7d',  value: expiring,color: 'text-yellow-400' },
      ];
      document.getElementById('stats').innerHTML = cards.map(c => `
        <div class="bg-zinc-900 border border-zinc-800 rounded-xl px-5 py-4">
          <div class="${c.color} text-3xl brand">${c.value}</div>
          <div class="text-zinc-500 text-xs uppercase tracking-widest mt-1">${c.label}</div>
        </div>`).join('');
    }

    // ── Members ─────────────────────────────────────────────
    async function loadMembers() {
      try {
        const res = await fetch('/api/members', { headers: headers() });
        const data = await res.json();
        if (!data.success) throw new Error(data.message);
        allMembers = data.data;
        renderStats(allMembers);
        renderMembers(allMembers);
      } catch (e) {
        if (e.message.includes('token')) logout();
      }
    }

    function filterMembers() {
      const q = document.getElementById('search').value.toLowerCase();
      const s = document.getElementById('filterStatus').value;
      const filtered = allMembers.filter(m =>
        (!s || m.status === s) &&
        (!q || m.name.toLowerCase().includes(q) || m.phone.includes(q))
      );
      renderMembers(filtered);
    }

    function renderMembers(members) {
      const el = document.getElementById('member-list');
      if (!members.length) { el.innerHTML = '<p class="text-zinc-500 text-sm">No members found.</p>'; return; }

      el.innerHTML = members.map(m => {
        const days = m.daysRemaining;
        const dayLabel = days < 0 ? `${Math.abs(days)}d overdue` : days === 0 ? 'Expires today' : `${days}d left`;
        const dayColor = days < 0 ? 'text-red-400' : days <= 7 ? 'text-yellow-400' : 'text-green-400';
        const badge = `<span class="px-2 py-0.5 rounded-full text-xs badge-${m.status}">${m.status}</span>`;

        return `
        <div class="bg-zinc-900 border border-zinc-800 rounded-xl px-5 py-4 flex flex-col md:flex-row md:items-center gap-4">
          <div class="flex-1">
            <div class="flex items-center gap-2 mb-1">
              <span class="font-semibold">${m.name}</span>
              ${badge}
            </div>
            <div class="text-zinc-500 text-sm">${m.phone}</div>
            <div class="text-xs mt-1">
              <span class="text-zinc-600">Expires:</span>
              <span class="text-zinc-400">${new Date(m.membership_expiry).toLocaleDateString()}</span>
              <span class="${dayColor} ml-2 font-medium">${dayLabel}</span>
            </div>
          </div>
          <div class="flex flex-wrap gap-2">
            <button onclick="checkin('${m._id}', '${m.name}')"
              class="px-3 py-1.5 bg-zinc-800 hover:bg-orange-500 hover:text-black text-sm rounded-lg transition font-medium">
              ✅ Check-in
            </button>
            <button onclick="openPlanModal('${m._id}', '${m.name}', \`${(m.diet_plan||'').replace(/`/g,"'")}\`, \`${(m.workout_plan||'').replace(/`/g,"'")}\`)"
              class="px-3 py-1.5 bg-zinc-800 hover:bg-zinc-700 text-sm rounded-lg transition">
              📋 Plan
            </button>
          </div>
        </div>`;
      }).join('');
    }

    // ── Check-in ────────────────────────────────────────────
    async function checkin(id, name) {
      try {
        const res = await fetch('/api/attendance/checkin', {
          method: 'POST',
          headers: headers(),
          body: JSON.stringify({ memberId: id }),
        });
        const data = await res.json();
        if (!data.success) return alert(`⚠️ ${data.message}`);
        const msg = data.warning ? `✅ ${name} checked in!\n⚠️ ${data.warning}` : `✅ ${name} checked in!`;
        alert(msg);
      } catch (e) { alert('Check-in failed'); }
    }

    async function loadCheckins() {
      const el = document.getElementById('checkin-list');
      try {
        const res = await fetch('/api/attendance', { headers: headers() });
        const data = await res.json();
        if (!data.success) throw new Error(data.message);
        if (!data.data.length) { el.innerHTML = '<p class="text-zinc-500 text-sm">No check-ins today yet.</p>'; return; }

        el.innerHTML = data.data.map(r => `
          <div class="bg-zinc-900 border border-zinc-800 rounded-xl px-5 py-3 flex items-center justify-between">
            <div>
              <span class="font-medium">${r.member?.name || 'Unknown'}</span>
              <span class="text-zinc-500 text-sm ml-2">${r.member?.phone || ''}</span>
            </div>
            <div class="text-zinc-400 text-sm">${new Date(r.checkedInAt).toLocaleTimeString()}</div>
          </div>`).join('');
      } catch (e) { el.innerHTML = '<p class="text-red-400 text-sm">Failed to load.</p>'; }
    }

    // ── Register ────────────────────────────────────────────
    async function registerMember() {
      const msg = document.getElementById('reg-msg');
      const body = {
        name: document.getElementById('reg-name').value,
        phone: document.getElementById('reg-phone').value,
        membership_start: document.getElementById('reg-start').value,
        membership_expiry: document.getElementById('reg-expiry').value,
      };

      try {
        const res = await fetch('/api/members/register', {
          method: 'POST', headers: headers(), body: JSON.stringify(body),
        });
        const data = await res.json();
        msg.classList.remove('hidden', 'bg-green-900/40', 'text-green-300', 'bg-red-900/40', 'text-red-300');
        if (data.success) {
          msg.classList.add('bg-green-900/40', 'text-green-300');
          msg.textContent = `✅ ${data.data.name} registered!`;
          ['reg-name','reg-phone','reg-start','reg-expiry'].forEach(id => document.getElementById(id).value = '');
          loadMembers();
        } else {
          msg.classList.add('bg-red-900/40', 'text-red-300');
          msg.textContent = data.message;
        }
      } catch (e) {
        msg.classList.remove('hidden');
        msg.textContent = 'Registration failed';
      }
    }

    // ── Plan Modal ───────────────────────────────────────────
    function openPlanModal(id, name, diet, workout) {
      currentMemberId = id;
      document.getElementById('plan-member-name').textContent = `Member: ${name}`;
      document.getElementById('plan-diet').value = diet;
      document.getElementById('plan-workout').value = workout;
      document.getElementById('plan-note').value = '';
      document.getElementById('plan-modal').classList.remove('hidden');
    }

    function closeModal() {
      document.getElementById('plan-modal').classList.add('hidden');
      currentMemberId = null;
    }

    async function savePlan() {
      try {
        const res = await fetch('/api/plans/assign-plan', {
          method: 'PUT',
          headers: headers(),
          body: JSON.stringify({
            memberId: currentMemberId,
            diet_plan: document.getElementById('plan-diet').value,
            workout_plan: document.getElementById('plan-workout').value,
            note: document.getElementById('plan-note').value,
          }),
        });
        const data = await res.json();
        if (!data.success) return alert(`Error: ${data.message}`);
        closeModal();
        loadMembers();
        alert('✅ Plan saved!');
      } catch (e) { alert('Failed to save plan'); }
    }

    // ── Init ─────────────────────────────────────────────────
    loadMembers();
    // Set today as default start date
    document.getElementById('reg-start').value = new Date().toISOString().split('T')[0];
  </script>
</body>
</html>
