<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>GymOS — Join Now</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet"/>
  <style>
    body{font-family:'DM Sans',sans-serif;background:#0a0a0a;color:#e4e4e7}
    .brand{font-family:'Bebas Neue',sans-serif;letter-spacing:.05em}
    label{display:block;font-size:11px;color:#71717a;text-transform:uppercase;letter-spacing:.1em;margin-bottom:4px}
    input,select{width:100%;background:#18181b;border:1px solid #3f3f46;border-radius:8px;padding:10px 14px;color:#fff;font-size:14px;outline:none;transition:border .2s}
    input:focus,select:focus{border-color:#f97316}
    select option{background:#18181b}
  </style>
</head>
<body class="min-h-screen py-10 px-4">
  <div class="max-w-2xl mx-auto">
    <div class="text-center mb-8">
      <div class="brand text-5xl text-orange-500">GYMOS</div>
      <p class="text-zinc-400 mt-1">Member Registration</p>
    </div>

    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-8">
      <h2 class="brand text-2xl text-white mb-6">Join the Gym</h2>

      <div id="msg" class="hidden mb-5 px-4 py-3 rounded-lg text-sm"></div>

      <!-- Personal Info -->
      <p class="text-orange-500 text-xs uppercase tracking-widest font-semibold mb-4">Personal Information</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
        <div>
          <label>Full Name *</label>
          <input id="fullName" placeholder="Muhammad Ali"/>
        </div>
        <div>
          <label>Father's Name</label>
          <input id="fatherName" placeholder="Muhammad Hassan"/>
        </div>
        <div>
          <label>Phone Number * (for login)</label>
          <input id="phone" type="tel" placeholder="03001234567"/>
        </div>
        <div>
          <label>CNIC</label>
          <input id="cnic" placeholder="XXXXX-XXXXXXX-X"/>
        </div>
        <div>
          <label>Date of Birth</label>
          <input id="dateOfBirth" type="date"/>
        </div>
        <div>
          <label>Gender</label>
          <select id="gender">
            <option value="male">Male</option>
            <option value="female">Female</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div>
          <label>Email</label>
          <input id="email" type="email" placeholder="ali@email.com"/>
        </div>
        <div>
          <label>Membership Type</label>
          <select id="membershipType">
            <option value="monthly">Monthly</option>
            <option value="quarterly">Quarterly (3 months)</option>
            <option value="yearly">Yearly</option>
          </select>
        </div>
        <div class="md:col-span-2">
          <label>Home Address</label>
          <input id="address" placeholder="House #, Street, Area, City"/>
        </div>
      </div>

      <!-- Emergency Contact -->
      <p class="text-orange-500 text-xs uppercase tracking-widest font-semibold mb-4">Emergency Contact</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
        <div>
          <label>Contact Name</label>
          <input id="emergencyContact" placeholder="Contact person name"/>
        </div>
        <div>
          <label>Contact Phone</label>
          <input id="emergencyContactPhone" type="tel" placeholder="03001234567"/>
        </div>
      </div>

      <!-- Account -->
      <p class="text-orange-500 text-xs uppercase tracking-widest font-semibold mb-4">Create Account Password</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
        <div>
          <label>Password *</label>
          <div class="relative">
            <input id="password" type="password" placeholder="Min 6 characters" style="padding-right:44px"/>
            <button type="button" onclick="togglePwd('password','eye1','eye2')"
              class="absolute right-3 top-1/2 -translate-y-1/2 text-zinc-400 hover:text-orange-400">
              <svg id="eye1" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
              <svg id="eye2" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.542-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.542 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/></svg>
            </button>
          </div>
        </div>
        <div>
          <label>Confirm Password *</label>
          <input id="confirmPassword" type="password" placeholder="Repeat password"/>
        </div>
      </div>

      <button onclick="register()"
        class="w-full bg-orange-500 hover:bg-orange-400 active:scale-95 text-black font-bold py-3 rounded-xl transition-all text-base">
        Submit Registration
      </button>
      <p class="text-center text-zinc-500 text-sm mt-4">
        Already registered? <a href="/member" class="text-orange-400 hover:text-orange-300">Login here</a>
      </p>
    </div>
  </div>

  <script>
    function togglePwd(inputId, eyeOnId, eyeOffId) {
      const input  = document.getElementById(inputId);
      const eyeOn  = document.getElementById(eyeOnId);
      const eyeOff = document.getElementById(eyeOffId);
      const isHidden = input.type === 'password';
      input.type = isHidden ? 'text' : 'password';
      eyeOn.classList.toggle('hidden',  isHidden);
      eyeOff.classList.toggle('hidden', !isHidden);
    }

    function showMsg(text, type) {
      const el = document.getElementById('msg');
      el.classList.remove('hidden','bg-green-900/40','text-green-300','bg-red-900/40','text-red-300');
      el.classList.add(type==='success'?'bg-green-900/40':'bg-red-900/40', type==='success'?'text-green-300':'text-red-300');
      el.textContent = text;
      el.scrollIntoView({ behavior:'smooth' });
    }

    async function register() {
      const password = document.getElementById('password').value;
      const confirm  = document.getElementById('confirmPassword').value;

      if (!document.getElementById('fullName').value || !document.getElementById('phone').value || !password)
        return showMsg('Please fill in Full Name, Phone, and Password.', 'error');
      if (password.length < 6)
        return showMsg('Password must be at least 6 characters.', 'error');
      if (password !== confirm)
        return showMsg('Passwords do not match.', 'error');

      const body = {
        fullName:              document.getElementById('fullName').value,
        fatherName:            document.getElementById('fatherName').value,
        phone:                 document.getElementById('phone').value,
        cnic:                  document.getElementById('cnic').value,
        address:               document.getElementById('address').value,
        dateOfBirth:           document.getElementById('dateOfBirth').value,
        gender:                document.getElementById('gender').value,
        email:                 document.getElementById('email').value,
        membershipType:        document.getElementById('membershipType').value,
        emergencyContact:      document.getElementById('emergencyContact').value,
        emergencyContactPhone: document.getElementById('emergencyContactPhone').value,
        password,
      };

      try {
        const res  = await fetch('/api/member/register', {
          method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body),
        });
        const data = await res.json();
        if (data.success) {
          showMsg('✅ Registration submitted! The gym owner will review and approve your account. You will be notified on WhatsApp.', 'success');
          document.querySelectorAll('input,select').forEach(el => { if (el.type !== 'button') el.value = ''; });
        } else {
          showMsg(data.message, 'error');
        }
      } catch(e) { showMsg('Registration failed. Please try again.', 'error'); }
    }
  </script>
</body>
</html>
